{
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "jq -r '(.model.display_name // \"Claude\") as $model | .context_window.used_percentage as $used | if $used == null then $model else \"\\($model) | ctx: \\($used | round)% used\" end'"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ]; then bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\" ]; then node \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\"; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": true
  }
}
