# Personal work environment, sourced from the Nix-managed ~/.zshrc.
# Plain zsh (no Nix escaping). Ported from the Stow ~/.zshrc.
# NOTE: no Zellij auto-start here — WezTerm handles tabs.

# Determinate Nix did not patch /etc/zshrc; load it for every new shell.
if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# --- Kiro CLI pre block ---
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# --- Zsh options ---
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS CORRECT INTERACTIVE_COMMENTS
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY APPEND_HISTORY
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# --- PATH ---
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# --- Completion (including Homebrew formula completions) ---
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit

# --- Environment ---
export EDITOR="nvim"
export VISUAL="nvim"
export LANG=en_US.UTF-8

# --- NVM (lazy-loaded for faster startup) ---
export NVM_DIR="$HOME/.nvm"
typeset -g _dotfiles_av_npm_bin="$HOME/.local/share/av-npm/bin"
nvm() {
  local nvm_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm"
  if [[ ! -s "$nvm_prefix/nvm.sh" ]]; then
    print -u2 'nvm is missing from Homebrew; apply the dotfiles configuration first.'
    return 127
  fi
  mkdir -p "$NVM_DIR" || return
  unfunction nvm node npm npx 2>/dev/null
  \. "$nvm_prefix/nvm.sh"
  [ -s "$nvm_prefix/etc/bash_completion.d/nvm" ] && \. "$nvm_prefix/etc/bash_completion.d/nvm"
  if [[ -x /usr/local/bin/npm && -x "$_dotfiles_av_npm_bin/npm" ]]; then
    # Prioritize only AV's npm entry point, leaving node and npx under nvm's control.
    functions[_dotfiles_nvm]="$functions[nvm]"
    nvm() {
      # Let nvm's nested calls finish before restoring the caller's PATH order.
      local -i _dotfiles_nvm_depth=$(( ${_dotfiles_nvm_depth:-0} + 1 ))
      _dotfiles_nvm "$@"
      local nvm_status=$?
      if (( _dotfiles_nvm_depth == 1 )); then
        path=("$_dotfiles_av_npm_bin" "${(@)path:#$_dotfiles_av_npm_bin}")
      fi
      return "$nvm_status"
    }
  fi
  nvm "$@"
}
node() { nvm --version >/dev/null 2>&1; unfunction node 2>/dev/null; command node "$@"; }
npm()  { nvm --version >/dev/null 2>&1; unfunction npm 2>/dev/null;  command npm "$@"; }
npx()  { nvm --version >/dev/null 2>&1; unfunction npx 2>/dev/null;  command npx "$@"; }
_nvm_default_alias=$(cat "$NVM_DIR/alias/default" 2>/dev/null)
if [[ -n "$_nvm_default_alias" ]]; then
  _nvm_default_dir=("$NVM_DIR/versions/node/v${_nvm_default_alias}"*(Nn[1]))
  [[ -n "$_nvm_default_dir" ]] && export PATH="${_nvm_default_dir}/bin:$PATH"
fi
unset _nvm_default_alias _nvm_default_dir
[[ -x /usr/local/bin/npm && -x "$_dotfiles_av_npm_bin/npm" ]] && \
  path=("$_dotfiles_av_npm_bin" "${(@)path:#$_dotfiles_av_npm_bin}")

# --- Bun ---
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# --- Antigravity ---
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# --- Tool integrations ---
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh) 2>/dev/null

# --- History navigation + Option+Arrow word nav ---
bindkey '^P' up-line-or-history
bindkey '^N' down-line-or-history
bindkey '\e[1;3C' forward-word
bindkey '\e[1;3D' backward-word

# --- Kiro ---
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"

# --- CI&T Claude Code configuration (secrets kept out of git) ---
[[ -f "$HOME/.zsh/secrets.zsh" ]] && source "$HOME/.zsh/secrets.zsh"

# --- Work aliases / env ---
alias nexus="$HOME/Developer/infomedia-nexus/nexus"
alias claude-mem='bun "$HOME/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-cli.js" start'
export TREEHOUSE_ROOT="$HOME/Developer/treehouse-pool"

# --- Homebrew shell integrations ---
if [[ "$TERM" != dumb ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  bindkey '^f' autosuggest-accept
fi
# Load after all integrations have created their ZLE widgets.
[[ -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
