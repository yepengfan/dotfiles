# Personal work environment, sourced from the Nix-managed ~/.zshrc.
# Plain zsh (no Nix escaping). Ported from the Stow ~/.zshrc.
# NOTE: no Zellij auto-start here — WezTerm handles tabs.

# Determinate Nix did not patch /etc/zshrc; load it for every new shell.
if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# --- Kiro CLI pre block ---
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# --- Zsh options ---
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS CORRECT INTERACTIVE_COMMENTS
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY APPEND_HISTORY
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# --- PATH ---
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# --- Environment ---
export EDITOR="nvim"
export VISUAL="nvim"
export LANG=en_US.UTF-8

# --- NVM (lazy-loaded for faster startup) ---
export NVM_DIR="$HOME/.nvm"
nvm() {
  unfunction nvm node npm npx 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}
node() { nvm --version >/dev/null 2>&1; unfunction node 2>/dev/null; command node "$@"; }
npm()  { nvm --version >/dev/null 2>&1; unfunction npm 2>/dev/null;  command npm "$@"; }
npx()  { nvm --version >/dev/null 2>&1; unfunction npx 2>/dev/null;  command npx "$@"; }
_nvm_default_alias=$(cat "$NVM_DIR/alias/default" 2>/dev/null)
if [[ -n "$_nvm_default_alias" ]]; then
  _nvm_default_dir=("$NVM_DIR/versions/node/v${_nvm_default_alias}"*(Nn[1]))
  [[ -n "$_nvm_default_dir" ]] && export PATH="${_nvm_default_dir}/bin:$PATH"
fi
unset _nvm_default_alias _nvm_default_dir

# --- Bun ---
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# --- Antigravity ---
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# --- Tool integrations ---
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh) 2>/dev/null

# --- History navigation + Option+Arrow word nav ---
bindkey '^P' up-line-or-history
bindkey '^N' down-line-or-history
bindkey '\e[1;3C' forward-word
bindkey '\e[1;3D' backward-word

# --- Kiro ---
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"

# --- CI&T Claude Code configuration (secrets kept out of git) ---
[[ -f "$HOME/.zsh/secrets.zsh" ]] && source "$HOME/.zsh/secrets.zsh"

# --- Work aliases / env ---
alias nexus="$HOME/Developer/infomedia-nexus/nexus"
alias claude-mem='bun "$HOME/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-cli.js" start'
export TREEHOUSE_ROOT="$HOME/Developer/treehouse-pool"
